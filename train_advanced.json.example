{
  "_comment": "Copy to train_advanced.json. These keys are NOT touched by the web UI (which rewrites train_settings.json with a fixed set of keys). Precedence: train_settings.json > train_advanced.json > preset > defaults. Everything is opt-in: if this file is absent, training is identical to the historical behavior. The EFFECTIVE CONFIG block printed on startup shows the origin of each value.",

  "_preset": "stable_v2 activates the recommended set all at once: epoch sampler, fp32 lora_dtype, 1e-6 eps, [0.9,0.99] betas, high-precision targets, window loss, 5 checkpoints, NaN/OOM guards. Explicit keys below still take precedence.",
  "preset": "",

  "_A1": "Precision. fp32 prevents small updates from rounding to zero in bf16 (relative epsilon ~0.0039). Costs ~+235 MB of VRAM plus activation casting: verify the 1024 phase before setting permanently.",
  "lora_dtype": "bf16",
  "high_precision_targets": false,

  "_A2": "epoch = each image is seen once per epoch. legacy = uniform sampling per bucket, which gives a single image up to 16x more steps than one in a large bucket.",
  "sampler": "legacy",

  "_A3_A8": "Guards. A single inf causes clip_grad_norm_ to scale all gradients to NaN and AdamW to permanently write them into its momentum states.",
  "nan_guard": true,
  "nan_abort_after": 20,
  "max_loss": 0.0,
  "oom_guard": true,
  "oom_abort_after": 3,

  "_A4": "abort refuses to silently restart from step 0 when the checkpoint exists but cannot be restored.",
  "resume_on_corrupt": "abort",

  "_A5_A7": "warmup_units clarifies that total_steps are micro-steps but the schedule operates in optimizer updates. 1e-6 eps and [0.9,0.99] betas work better for short runs: with 750 updates, beta2=0.999 has a horizon of ~1000 and never warms up.",
  "warmup_units": "updates",
  "optimizer": "adamw8bit_paged",
  "optimizer_eps": 1e-8,
  "optimizer_betas": [0.9, 0.999],

  "_B1": "content biases toward low sigma (detail and likeness), style toward high sigma (composition and color). Bell weighting rebalances micro-batches within the accumulation window.",
  "timestep_weighting": "none",
  "content_or_style": "balanced",
  "logit_normal_mu": 0.0,
  "logit_normal_sigma": 1.0,
  "sigma_min": 0.0,
  "sigma_max": 1.0,

  "_B3": "noise_offset fixes DDPM's non-zero terminal SNR. In rectified flow, sigma=1 is already pure distribution noise, so the problem it solves does not exist here: leave it at 0.",
  "noise_offset": 0.0,

  "_B2": "The exported LoRA and previews use EMA weights; resume_checkpoint retains raw weights. Warns if decay horizon exceeds a third of the run.",
  "use_ema": false,
  "ema_decay": 0.99,
  "ema_device": "cpu",

  "_B4": "cosine | constant | linear | cosine_with_restarts | step",
  "lr_scheduler": "cosine",
  "lr_num_cycles": 3,
  "lr_step_gamma": 0.5,
  "lr_step_count": 4,

  "_C1": "Fixed sigmas and noise per image: converts a noisy scalar into a readable curve to determine which checkpoint is the good one. For fewer than ~30 images, use val_cache_dir instead of val_split.",
  "val_split": 0.0,
  "val_cache_dir": "",
  "validate_every": 0,
  "validation_sigmas": [0.25, 0.5, 0.75, 1.0],
  "val_seed": 1234,

  "_C2_C3_C4": "train_log.csv saves raw loss and sigma for each step, allowing you to group by sigma decile offline. ss_network_alpha matters: without it, a loader assumes alpha=rank and applies the LoRA at half strength.",
  "loss_display": "cumulative",
  "loss_window": 100,
  "csv_log": true,
  "max_checkpoints_to_keep": 0,
  "export_metadata": true,
  "export_alpha_tensors": false,

  "_C5": "Requires sample_prompts in pre_cache_settings.json and re-running Pre-Cache.",
  "preview_source": "caption",
  "preview_walk_seed": false,

  "_D3": "Useful at 0.05-0.10 for style LoRAs. For a character LoRA with a trigger word, it is usually counterproductive: it teaches it to trigger unconditionally.",
  "caption_dropout_rate": 0.0
}